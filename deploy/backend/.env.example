# ============================================
# AgriNova AI — Backend Environment Variables
# ============================================
# Copy to backend/.env and fill in real values

# ---- MySQL Database ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agrinova
DB_USER=root
DB_PASSWORD=Gani@18

# ---- JWT Auth ----
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ---- ML Service ----
ML_SERVICE_URL=http://localhost:9000

# ---- App ----
APP_ENV=development
# APP_ENV=production
